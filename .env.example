# Supabase Configuration
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Client Vite Environment Variables (mirrors above)
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Server-Only Keys (Keep confidential, never commit to git)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Session & Admin Authentication
SESSION_SECRET="generate-a-strong-random-32-char-secret-for-session-cookies"
ADMIN_INITIAL_PASSWORD="your-secure-initial-admin-password"

# Optional Database URL for direct migrations
DATABASE_URL="postgresql://postgres:password@db.your-project-id.supabase.co:5432/postgres"

# Optional Cron Authentication
CRON_SECRET="your-cron-secret-token"
